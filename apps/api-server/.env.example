# SQLAlchemy / Alembic (psycopg3 dialect)
DATABASE_URL=postgresql+psycopg://align_owner:local_dev_only@localhost:5432/align

# LangGraph PostgresSaver.setup() uses a plain URL (no +psycopg):
# postgresql://align_owner:local_dev_only@localhost:5432/align

# Azure OpenAI Responses API — API runtime and real-Azure smokes; CI mocks these
AZURE_OPENAI_API_KEY=
# Use the exact Azure resource endpoint, including its scheme and host:
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# Azure deployment name (which may differ from the underlying model ID):
AZURE_MODEL_NAME=<gpt-5.4-deployment-name>
# Optional — default 2025-04-01-preview
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
