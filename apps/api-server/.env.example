# SQLAlchemy / Alembic (psycopg3 dialect)
DATABASE_URL=postgresql+psycopg://align_owner:local_dev_only@localhost:5432/align

# LangGraph PostgresSaver.setup() uses a plain URL (no +psycopg):
# postgresql://align_owner:local_dev_only@localhost:5432/align

# Azure OpenAI — used by clinical_ai.llm_client (local prompt smoke only; CI never needs these)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_MODEL_NAME=<deployment-name>
# Optional — default 2025-04-01-preview
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
