{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "git": {
    "deploymentEnabled": false
  },
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "apps/urgent-care-app/Dockerfile",
      "runtime": "container",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "ALIGN_API_BASE_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api-server",
      "entrypoint": "Dockerfile",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
