# SQLAlchemy / Alembic (psycopg3 dialect)
DATABASE_URL=postgresql+psycopg://align_owner:local_dev_only@localhost:5432/align

# LangGraph PostgresSaver.setup() uses a plain URL (no +psycopg):
# postgresql://align_owner:local_dev_only@localhost:5432/align

# Azure OpenAI (clinical_ai agents) — Pilot-V2 style
# AZURE_TARGET_URL=https://<resource>.cognitiveservices.azure.com/openai/deployments/<deployment>/chat/completions?api-version=<api-version>
# Or Responses API URL; llm_client maps endpoint + api-version automatically.
AZURE_TARGET_URL=
AZURE_OPENAI_API_KEY=
AZURE_MODEL_NAME=